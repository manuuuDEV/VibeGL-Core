    "turbo": "^2.10.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "husky": "^8.0.0",
    "lint-staged": "^14.0.0"
  },
  "packageManager": "pnpm@8.15.1",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "three-stdlib": "^2.36.1"
