{
  "name": "@vibe-gl/math-utils",
  "version": "1.1.0",
  "type": "module",
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "keywords": [
    "threejs",
    "math",
    "physics",
    "sharedarraybuffer",
    "euler"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "import": "./dist/worker/index.js",
      "require": "./dist/worker/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "description": "Predictive physics engine with SharedArrayBuffer and Sweep and Prune collision detection",
  "author": "manuuudev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/manuuuDEV/VibeGL-Core.git",
    "directory": "packages/math-utils"
  },
  "publishConfig": {
    "access": "public"
  }
}