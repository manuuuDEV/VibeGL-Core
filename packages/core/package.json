{
  "name": "@vibe-gl/core",
  "version": "1.1.0",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
    },
    "./hooks": {
        "types": "./dist/hooks/index.d.ts",
        "import": "./dist/hooks/index.mjs",
        "require": "./dist/hooks/index.js"
    },
    "./components": {
        "types": "./dist/components/index.d.ts",
        "import": "./dist/components/index.mjs",
        "require": "./dist/components/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@vibe-gl/math-utils": "workspace:*",
    "react": "^18.3.1",
    "three": "^0.160.1"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "three": ">=0.160.0",
    "@react-three/fiber": ">=8.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.160.0",
    "tsup": "^8.0.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}