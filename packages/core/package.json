{
  "name": "@vibe-gl/core",
  "version": "1.1.0",
  "type": "module",
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "keywords": [
    "threejs",
    "react-three-fiber",
    "physics",
    "r3f",
    "engine",
    "webgl"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js",
      "require": "./dist/hooks/index.cjs"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js",
      "require": "./dist/components/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "@vibe-gl/math-utils": "workspace:*",
    "react": "^19.2.8",
    "three": "^0.185.1"
  },
  "peerDependencies": {
    "@react-three/fiber": ">=8.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "three": ">=0.160.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.3",
    "jsdom": "^30.0.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "description": "React components for declarative 3D scenes with integrated physics",
  "author": "manuuudev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/manuuuDEV/VibeGL-Core.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  }
}